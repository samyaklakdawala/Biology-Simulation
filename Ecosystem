// ADVANCE → SHOW FUTURES
// ============================================================
function onAdvance() {
  if (!state.prediction) return;
  // Build Three Futures based on sliders
  const futures = buildFutures();
  document.getElementById('futA').textContent = futures.A;
  document.getElementById('futB').textContent = futures.B;
  document.getElementById('futC').textContent = futures.C;
  document.getElementById('futuresCard').style.display = 'block';
  document.getElementById('advanceBtn').style.display = 'none';
  document.getElementById('revealBtn').disabled = true;
  state.futureRank = null;
  document.querySelectorAll('.rank-btn').forEach(b => b.classList.remove('picked'));
  document.getElementById('justifInput').value = '';
  toast('📋 Three Futures revealed — rank them before you reveal!');
}

function buildFutures() {
  const { prod, eff, levels, human } = state.sliders;
  const score = prod*2 + eff*2 - levels*1 - human*2;
  return {
    A: `With high efficiency and strong primary productivity, energy cascades through all trophic levels. Apex predator populations thrive, carbon sequestration peaks, and land pressure stays low.`,
    B: `Energy is transferred with typical losses at each trophic level. Middle trophic levels sustain themselves, but apex predators receive limited energy. Land use is moderate.`,
    C: `Energy losses compound at each level. The apex predator level collapses below viable population thresholds. Reduced plant cover lowers carbon sequestration sharply and land per person spikes.`
  };
}

function setRank(letter) {
  state.futureRank = letter;
  document.querySelectorAll('.rank-btn').forEach(b => b.classList.remove('picked'));
  event.target.classList.add('picked');
  document.getElementById('revealBtn').disabled = !state.futureRank;
}

function revealResult() {
  if (!state.futureRank) return;
  computeRound();
}

// ============================================================
// COMPUTE ROUND & SHOW MODAL
// ============================================================
function computeRound() {
  const { prod, eff, levels, human } = state.sliders;
  const prev = { ...state.metrics };

  // Compute new metrics using ecological rules
  const prodMulti = 0.3 + prod * 0.175;       // 0.3–1.0
  const effPct    = 0.05 + eff * 0.0375;       // 5%–20%
  const levFactor = 1 - (levels * 0.1);        // more levels = more loss
  const humanF    = 1 + human * 0.15;          // human consumption pressure

  // Check for random events
  let eventEffect = { prod:1, carbon:1, consumer:1 };
  const unused = EVENTS.filter(e => !state.eventsUsed.includes(e.id));
  let triggered = null;
  if (state.round >= 2 && unused.length > 0 && Math.random() < 0.55) {
    triggered = unused[Math.floor(Math.random()*unused.length)];
    state.eventsUsed.push(triggered.id);
    if (triggered.id==='drought') eventEffect.prod = 0.8;
    if (triggered.id==='invasive') eventEffect.consumer = 0.85;
    if (triggered.id==='eutro') eventEffect.carbon = 0.85;
  }

  const baseEnergy = 100 * prodMulti * eventEffect.prod;
  const e0 = Math.min(100, baseEnergy);
  const e1 = Math.min(100, e0 * effPct * levFactor * eventEffect.consumer * 3);
  const e2 = Math.min(100, e1 * effPct * levFactor * 2);
  const land = Math.min(100, 30 + human*15 + levels*5 - prod*5);
  const carbon = Math.min(100, Math.max(5, 90*prodMulti*eventEffect.carbon - human*10));

  state.metrics = { energy0:Math.round(e0), energy1:Math.round(e1), energy2:Math.round(e2), land:Math.round(land), carbon:Math.round(carbon) };
  state.history.push({ round:state.round, sliders:{...state.sliders}, metrics:{...state.metrics} });

  // Future match
  const netChange = (state.metrics.energy2 - prev.energy2) + (state.metrics.carbon - prev.carbon) - (state.metrics.land - prev.land);
  const actualFuture = netChange > 10 ? 'A' : netChange > -5 ? 'B' : 'C';

  // Determine outcome label
  const score = e0*0.3 + e2*0.3 + carbon*0.3 - land*0.1;
  let outcome = score > 65 ? 'thriving' : score > 45 ? 'stable' : score > 30 ? 'stressed' : 'crisis';

  showModal(prev, outcome, actualFuture, triggered);
  renderBars(); drawScene(); drawChart();
  if (triggered) setTimeout(() => showEvent(triggered), 400);
}

function showModal(prev, outcome, actualFuture, triggered) {
  const m = state.metrics;
  const emojiMap = { thriving:'🌱 Thriving!', stable:'⚖️ Stable', stressed:'⚠️ Resources Stressed', crisis:'🔴 Crisis!' };
  document.getElementById('modalTitle').textContent = `Round ${state.round} Result: ${emojiMap[outcome]}`;

  // Outcome grid
  const items = [
    ['🌿 Producer Energy', prev.energy0, m.energy0],
    ['🐛 1° Consumer', prev.energy1, m.energy1],
    ['🦅 Apex Predator', prev.energy2, m.energy2],
    ['🏞️ Land Pressure', prev.land, m.land, true],
    ['🌳 Carbon Seq.', prev.carbon, m.carbon]
  ];
  document.getElementById('outcomeGrid').innerHTML = items.map(([lab,p,n,inv])=>{
    const diff = n - p;
    const up = inv ? diff < 0 : diff > 0;
    const down = inv ? diff > 0 : diff < 0;
    const arrow = diff > 2 ? '▲' : diff < -2 ? '▼' : '→';
    const cls = up ? 'o-up' : down ? 'o-down' : 'o-same';
    return `<div class="outcome-item"><div class="o-label">${lab}</div><div class="o-val ${cls}">${arrow} ${n}</div></div>`;
  }).join('');

  // Cause chain
  const { prod, eff, levels, human } = state.sliders;
  document.getElementById('chainBox').innerHTML = `
    <div class="chain-step"><span>Primary productivity set to <b>${prod}/4</b></span><span class="chain-arrow">→</span><span>Base energy = ${m.energy0} kJ/m²</span></div>
    <div class="chain-step"><span>Transfer efficiency ${(5+eff*3.75).toFixed(1)}%</span><span class="chain-arrow">→</span><span>Consumer energy = ${m.energy1} kJ/m²</span></div>
    <div class="chain-step"><span>${levels+2} trophic levels × losses</span><span class="chain-arrow">→</span><span>Apex predator = ${m.energy2} kJ/m²</span></div>
    <div class="chain-step"><span>Human consumption = ${human}/4</span><span class="chain-arrow">→</span><span>Land use index = ${m.land} | Carbon = ${m.carbon}</span></div>`;

  // Future reveal
  const fr = document.getElementById('futureReveal');
  fr.style.display = 'block';
  const matched = state.futureRank === actualFuture;
  document.getElementById('futureMatchText').textContent = `The actual outcome matched Future ${actualFuture}. You predicted Future ${state.futureRank} would be most likely — ${matched ? '✅ Correct!' : '❌ Interesting — let\'s see why.'}`;
  document.getElementById('futureWhyNot').textContent = actualFuture !== 'A' ? `Future A didn't happen because: the combination of high trophic levels and human consumption created compounding energy losses that overwhelmed productivity gains.` : `Future A happened because your choices maximised productivity while keeping consumption pressure low — energy cascaded through efficiently.`;
  document.getElementById('futureDiscuss').textContent = `💬 Discussion: What decision would have made Future A happen instead?`;

  // Real-world echo (cycle through)
  document.getElementById('rwEcho').textContent = RW_ECHOES[(state.round-1) % RW_ECHOES.length];
  document.getElementById('ibPrompt').textContent = IB_PROMPTS[(state.round-1) % IB_PROMPTS.length];

  document.getElementById('modal').classList.add('show');
  updateRoundBadge();
}

function closeModal() {
  document.getElementById('modal').classList.remove('show');
  state.round++;
  if (state.round > ROUNDS) {
    endSim(); return;
  }
  state.prediction = null;
  state.futureRank = null;
  document.getElementById('futuresCard').style.display = 'none';
  document.getElementById('advanceBtn').style.display = '';
  document.getElementById('advanceBtn').disabled = true;
  document.querySelectorAll('.pred-btn').forEach(b => b.className='pred-btn');
  buildTimeline();
  updateRoundBadge();
  toast(`🚀 Round ${state.round} begins!`);
}

function endSim() {
  buildTimeline();
  updateRoundBadge();
  document.getElementById('reflectionPanel').style.display = 'block';
  document.getElementById('reflectionPanel').scrollIntoView({ behavior:'smooth' });
  toast('🎓 Simulation complete! Reflect on your journey.');
