  const hcol = humanStress ? '#ef4444' : '#2563eb';
  html += `
    <circle cx="${hx}" cy="${hy-24}" r="10" fill="${hcol}" opacity=".9"/>
    <rect x="${hx-7}" y="${hy-14}" width="14" height="20" fill="${hcol}" rx="4" opacity=".9"/>
    <line x1="${hx-7}" y1="${hy}" x2="${hx-14}" y2="${hy+14}" stroke="${hcol}" stroke-width="3"/>
    <line x1="${hx+7}" y1="${hy}" x2="${hx+14}" y2="${hy+14}" stroke="${hcol}" stroke-width="3"/>
    <text x="${hx}" y="${hy+28}" text-anchor="middle" font-size="8" fill="${hcol}" font-family="Nunito,sans-serif" font-weight="700">${humanStress?'😰 Over-consuming':'😊 Sustainable'}</text>
  `;

  // WATER/RIVER — colour based on carbon/land
  const waterCol = m.carbon > 60 ? '#7dd3fc' : m.carbon > 30 ? '#fbbf24' : '#ef4444';
  html += `<ellipse cx="200" cy="248" rx="55" ry="14" fill="${waterCol}" opacity=".6"/>`;
  html += `<text x="200" y="252" text-anchor="middle" font-size="8" fill="#fff" font-family="Nunito,sans-serif" font-weight="700">Water</text>`;

  // 10% LOSS labels
  for (let l = 0; l < Math.min(levels+1, 4); l++) {
    const lx = 120 + l * 140;
    html += `<text x="${lx+40}" y="${200-l*30}" font-size="9" fill="#ef4444" font-family="Nunito,sans-serif" font-weight="700" opacity=".85">~${Math.round(100*(1-0.05-eff*0.0375))}% lost</text>`;
  }

  // ROUND label
  html += `<rect x="10" y="10" width="120" height="26" fill="#166534" rx="10" opacity=".85"/>`;
  html += `<text x="70" y="28" text-anchor="middle" font-size="12" fill="#fff" font-family="Fredoka One,cursive">Round ${state.round}</text>`;

  svg.innerHTML = html;
}

// ============================================================
// CHART
// ============================================================
function drawChart() {
  const canvas = document.getElementById('chartCanvas');
  canvas.width = canvas.offsetWidth || 600;
  canvas.height = 180;
  const ctx = canvas.getContext('2d');
  ctx.clearRect(0, 0, canvas.width, canvas.height);
  const h = canvas.height, w = canvas.width;
  const pad = { t:14, b:28, l:36, r:14 };
  const cw = w - pad.l - pad.r, ch = h - pad.t - pad.b;

  // Grid
  ctx.strokeStyle = '#e2e8f0'; ctx.lineWidth = 1;
  for (let i = 0; i <= 4; i++) {
    const y = pad.t + ch * (1 - i/4);
    ctx.beginPath(); ctx.moveTo(pad.l, y); ctx.lineTo(pad.l+cw, y); ctx.stroke();
    ctx.fillStyle = '#94a3b8'; ctx.font = '9px Nunito';
    ctx.fillText(i*25, 2, y+4);
  }

  if (state.history.length === 0) return;

  const series = [
    { key:'energy0', col:'#16a34a', label:'Producer' },
    { key:'energy1', col:'#f59e0b', label:'1° Cons.' },
    { key:'energy2', col:'#ef4444', label:'Apex' },
    { key:'carbon',  col:'#0ea5e9', label:'Carbon' },
  ];

  const pts = (key) => state.history.map((h,i) => ({
    x: pad.l + (i / (ROUNDS-1)) * cw,
    y: pad.t + ch * (1 - h.metrics[key]/100)
  }));

  series.forEach(s => {
    const points = pts(s.key);
    ctx.strokeStyle = s.col; ctx.lineWidth = 2.5;
    ctx.beginPath();
    points.forEach((p,i) => i===0 ? ctx.moveTo(p.x,p.y) : ctx.lineTo(p.x,p.y));
    ctx.stroke();
    points.forEach(p => {
      ctx.beginPath(); ctx.arc(p.x,p.y,4,0,Math.PI*2);
      ctx.fillStyle=s.col; ctx.fill();
    });
  });

  // Legend
  series.forEach((s,i) => {
    const lx = pad.l + i * 80;
    ctx.fillStyle = s.col; ctx.fillRect(lx, h-12, 12, 5);
    ctx.fillStyle='#374151'; ctx.font='8px Nunito'; ctx.fillText(s.label, lx+15, h-8);
  });
}

// Resize
window.addEventListener('resize', () => { if (state.history.length) drawChart(); drawScene(); });

// Init chart on load
window.addEventListener('load', () => { });
</script>
</body>
