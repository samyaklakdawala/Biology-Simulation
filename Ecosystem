  // DECOMPOSER pathway
  html += `
    <ellipse cx="420" cy="255" rx="28" ry="14" fill="#a16207" opacity=".7"/>
    <text x="420" y="259" text-anchor="middle" font-size="9" fill="#fff" font-family="Nunito,sans-serif" font-weight="700">Decomposers</text>
