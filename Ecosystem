function drawScene() {
  const svg = document.getElementById('mainSVG');
  const { prod, eff, levels, human } = state.sliders;
  const m = state.metrics;

  // Sky gradient shifts with productivity
  const skyH = Math.round(160 + prod * 20);
  const skyC1 = prod > 2 ? '#bae6fd' : prod > 1 ? '#dbeafe' : '#fde68a';
  const groundC = prod > 2 ? '#86efac' : prod > 1 ? '#bbf7d0' : '#d4b896';

  let html = `
    <!-- Sky -->
    <defs>
      <linearGradient id="skyGrad" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="${skyC1}"/>
        <stop offset="100%" stop-color="#f0fdf4"/>
      </linearGradient>
      <linearGradient id="groundGrad" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="${groundC}"/>
        <stop offset="100%" stop-color="#166534"/>
      </linearGradient>
    </defs>
    <rect width="760" height="320" fill="url(#skyGrad)"/>
    <rect y="220" width="760" height="100" fill="url(#groundGrad)" rx="0"/>
    <!-- Sun -->
    <circle cx="${prod>2?680:640}" cy="50" r="${20+prod*5}" fill="#fde68a" opacity=".95">
      <animate attributeName="r" values="${20+prod*5};${24+prod*5};${20+prod*5}" dur="3s" repeatCount="indefinite"/>
    </circle>
    <!-- Sun rays -->
    ${[0,45,90,135,180,225,270,315].map(a=>`<line x1="${prod>2?680:640}" y1="50" x2="${(prod>2?680:640)+Math.cos(a*Math.PI/180)*35}" y2="${50+Math.sin(a*Math.PI/180)*35}" stroke="#f59e0b" stroke-width="2" opacity=".7"/>`).join('')}
  `;

  // TREES — number and size depend on productivity and trophic levels
  const treeCount = Math.max(1, 2 + prod * 2);
  const treeHeight = 30 + prod * 18;
  const treePositions = [80,160,260,360,460,560,660,720];
  for (let i = 0; i < treeCount && i < treePositions.length; i++) {
    const tx = treePositions[i];
    const ty = 220 - treeHeight;
    const col = prod > 2 ? '#16a34a' : prod > 1 ? '#22c55e' : '#a3a87e';
    const col2 = prod > 2 ? '#15803d' : prod > 1 ? '#16a34a' : '#71717a';
    html += `
      <rect x="${tx-5}" y="${ty+treeHeight-10}" width="10" height="14" fill="#92400e" rx="2"/>
      <ellipse cx="${tx}" cy="${ty+treeHeight*0.35}" rx="${8+prod*3}" ry="${treeHeight*0.4}" fill="${col2}" opacity=".7"/>
      <ellipse cx="${tx}" cy="${ty+treeHeight*0.25}" rx="${7+prod*2}" ry="${treeHeight*0.35}" fill="${col}"/>
    `;
  }

  // ENERGY FLOW PARTICLES — show transfer efficiency visually
  const particleCount = 1 + Math.floor(eff * 1.5);
  const pCol = ['#22c55e','#f59e0b','#ef4444','#8b5cf6','#0ea5e9'];
  for (let lv = 0; lv < Math.min(levels+2, 4); lv++) {
    for (let p = 0; p < particleCount; p++) {
      const delay = (lv * 1.2 + p * 0.4).toFixed(1);
      const x1 = 100 + lv * 140, y1 = 240, x2 = x1 + 80, y2 = 140 - lv * 30;
      html += `<circle r="5" fill="${pCol[lv]}" opacity="0.85">
        <animateMotion dur="${2+lv*0.5}s" begin="${delay}s" repeatCount="indefinite">
          <mpath><path d="M${x1},${y1} Q${(x1+x2)/2},${(y1+y2)/2-40} ${x2},${y2}" style="fill:none"/></mpath>
        </animateMotion>
      </circle>`;
    }
  }

  // BIOMASS PYRAMID — builds visually
  const pyramidX = 560, pyramidY = 230;
  const pyramidLevels = Math.min(levels+2, 5);
  const lvColors = ['#22c55e','#f59e0b','#ef4444','#8b5cf6','#0ea5e9'];
  const lvLabels = ['Producers','1° Consumer','2° Consumer','3° Consumer','Apex'];
  const lvWidths = [130,95,65,42,25];
  for (let l = 0; l < pyramidLevels; l++) {
    const ry = pyramidY - l * 22;
    const rw = lvWidths[l] * (0.5 + prod*0.12);
    const rx = pyramidX - rw/2;
    const opacity = l === 0 ? 1 : l === 1 ? 0.85 : l === 2 ? 0.7 : 0.55;
