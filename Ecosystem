// ============================================================
// INIT
// ============================================================
function startSim() {
  document.getElementById('splash').classList.add('gone');
  document.getElementById('app').classList.add('show');
  setTimeout(() => { document.getElementById('splash').style.display = 'none'; }, 700);
  buildTimeline(); buildSliders(); buildPredGrid(); renderBars(); drawScene(); drawChart();
  toast('🌱 Simulation started! Set your sliders and make a prediction.');
}

function buildTimeline() {
  const el = document.getElementById('timeline');
  el.innerHTML = '';
  for (let i = 1; i <= ROUNDS; i++) {
    const dot = document.createElement('div');
    dot.className = 'phase-dot';
    dot.id = `pd${i}`;
    const cls = i < state.round ? 'done' : i === state.round ? 'active' : '';
    dot.innerHTML = `<div class="phase-circle ${cls}">${i < state.round ? '✓' : i}</div><div class="phase-label">Round ${i}</div>`;
    el.appendChild(dot);
    if (i < ROUNDS) {
      const line = document.createElement('div');
      line.className = `phase-line ${i < state.round ? 'done' : ''}`;
      el.appendChild(line);
    }
  }
}

function buildSliders() {
  const g = document.getElementById('slidersGrid');
  g.innerHTML = '';
  SLIDER_CFG.forEach(s => {
    const d = document.createElement('div');
    d.className = 'slider-row';
    d.innerHTML = `
      <div class="slider-top">
        <span class="slider-label">${s.icon} ${s.label}</span>
        <span class="slider-val" id="sv_${s.key}">${state.sliders[s.key]}</span>
      </div>
      <input type="range" min="0" max="4" step="1" value="${state.sliders[s.key]}"
        oninput="onSlider('${s.key}',this.value)" id="sl_${s.key}">
      <div class="slider-ends"><span>${s.lo}</span><span>${s.hi}</span></div>`;
    g.appendChild(d);
  });
}

function buildPredGrid() {
  const g = document.getElementById('predGrid');
  g.innerHTML = '';
  PREDICTIONS.forEach(p => {
    const b = document.createElement('button');
    b.className = 'pred-btn';
    b.id = `pb_${p.id}`;
    b.innerHTML = `${p.emoji}<br>${p.label}`;
    b.onclick = () => selectPred(p.id, p.cls);
    g.appendChild(b);
  });
}

function renderBars() {
  const m = state.metrics;
  const bars = [
    { key:'energy0', label:'🌿 Producer Energy (kJ/m²)', val:m.energy0 },
    { key:'energy1', label:'🐛 Primary Consumer Energy', val:m.energy1 },
    { key:'energy2', label:'🦅 Apex Predator Energy', val:m.energy2 },
    { key:'land',    label:'🏞️ Land Required (ha/person)', val:100-m.land },
    { key:'carbon',  label:'🌳 Carbon Sequestration', val:m.carbon }
  ];
  const el = document.getElementById('resBars');
  el.innerHTML = '';
  bars.forEach(b => {
    const pct = Math.max(0, Math.min(100, b.val));
    const col = pct > 60 ? '#16a34a' : pct > 30 ? '#d97706' : '#dc2626';
    const warn = pct < 20 ? '<span class="warn-blink">⚠️</span>' : '';
    el.innerHTML += `
      <div class="res-bar-wrap">
        <div class="res-bar-label"><span>${b.label}</span><span>${warn} <b style="color:${col}">${Math.round(b.val)}</b></span></div>
        <div class="res-bar-bg"><div class="res-bar-fill" style="width:${pct}%;background:${col}"></div></div>
      </div>`;
  });
}

