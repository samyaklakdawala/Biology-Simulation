<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Energy Flow & Trophic Levels — IB DP Biology</title>
<link href="https://fonts.googleapis.com/css2?family=Fredoka+One&family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">
<style>
  :root {
    --green:#16a34a; --amber:#d97706; --red:#dc2626;
    --bg:#f0fdf4; --card:#ffffff; --border:#bbf7d0;
    --text:#1a3c2b; --sub:#4b7c5e;
    --tl1:#22c55e; --tl2:#f59e0b; --tl3:#ef4444; --tl4:#8b5cf6;
    --tl5:#0ea5e9;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  body{font-family:'Nunito',sans-serif;background:var(--bg);color:var(--text);min-height:100vh;overflow-x:hidden}
  h1,h2,h3,.label{font-family:'Fredoka One',cursive}

  /* SPLASH */
  #splash{position:fixed;inset:0;background:linear-gradient(135deg,#052e16 0%,#14532d 50%,#166534 100%);display:flex;flex-direction:column;align-items:center;justify-content:center;z-index:9999;transition:opacity .6s}
  #splash.gone{opacity:0;pointer-events:none}
  .splash-sun{width:120px;height:120px;background:radial-gradient(circle,#fde68a,#f59e0b);border-radius:50%;box-shadow:0 0 60px #fde68a,0 0 120px #f59e0b44;animation:pulse 2s infinite}
  @keyframes pulse{0%,100%{transform:scale(1)}50%{transform:scale(1.08)}}
  .splash-title{font-family:'Fredoka One',cursive;font-size:3rem;color:#fff;text-align:center;margin-top:24px;text-shadow:0 4px 20px #000a}
  .splash-sub{color:#bbf7d0;font-size:1.1rem;margin-top:8px;text-align:center}
  .splash-tag{background:#16a34a;color:#fff;padding:6px 18px;border-radius:20px;font-size:.9rem;margin-top:12px;font-weight:700}
  .splash-btn{margin-top:40px;background:linear-gradient(135deg,#22c55e,#16a34a);color:#fff;border:none;padding:18px 56px;font-family:'Fredoka One',cursive;font-size:1.5rem;border-radius:50px;cursor:pointer;box-shadow:0 8px 30px #16a34a66;animation:bounce 1.5s infinite;transition:transform .15s}
  .splash-btn:hover{transform:scale(1.06)}
  @keyframes bounce{0%,100%{transform:translateY(0)}50%{transform:translateY(-8px)}}

  /* LAYOUT */
  #app{display:none;flex-direction:column;min-height:100vh;padding:12px;gap:12px;max-width:1280px;margin:0 auto}
  #app.show{display:flex}

  /* PHASE TIMELINE */
  .timeline{display:flex;gap:8px;align-items:center;background:var(--card);border-radius:16px;padding:12px 20px;border:2px solid var(--border)}
  .phase-dot{display:flex;flex-direction:column;align-items:center;gap:4px;flex:1;cursor:default}
  .phase-circle{width:40px;height:40px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-family:'Fredoka One',cursive;font-size:1.1rem;font-weight:900;border:3px solid #e2e8f0;background:#f1f5f9;color:#94a3b8;transition:all .4s}
  .phase-circle.active{background:linear-gradient(135deg,#22c55e,#16a34a);color:#fff;border-color:#16a34a;box-shadow:0 0 0 4px #bbf7d0;animation:ring 1.5s infinite}
  @keyframes ring{0%,100%{box-shadow:0 0 0 4px #bbf7d0}50%{box-shadow:0 0 0 8px #86efac}}
  .phase-circle.done{background:#16a34a;color:#fff;border-color:#15803d}
  .phase-label{font-size:.7rem;font-weight:700;color:var(--sub);text-align:center}
  .phase-line{flex:1;height:3px;background:#e2e8f0;border-radius:2px;max-width:40px}
  .phase-line.done{background:#16a34a}

  /* MAIN GRID */
  .main-grid{display:grid;grid-template-columns:1fr 340px;gap:12px;flex:1}
  .left-col{display:flex;flex-direction:column;gap:12px}
  .right-col{display:flex;flex-direction:column;gap:12px}

  /* CARDS */
  .card{background:var(--card);border-radius:16px;border:2px solid var(--border);padding:16px;overflow:hidden}
  .card-title{font-family:'Fredoka One',cursive;font-size:1.2rem;color:var(--text);margin-bottom:12px;display:flex;align-items:center;gap:8px}

  /* SVG SCENE */
  #scene-wrap{position:relative;border-radius:14px;overflow:hidden;background:linear-gradient(180deg,#bae6fd 0%,#dbeafe 40%,#d1fae5 70%,#86efac 100%);border:2px solid #93c5fd}
  #mainSVG{width:100%;display:block}

  /* SLIDERS */
  .sliders-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
  .slider-row{display:flex;flex-direction:column;gap:4px}
  .slider-label{font-size:.78rem;font-weight:700;color:var(--sub)}
  .slider-val{font-family:'Fredoka One',cursive;font-size:1rem;color:var(--tl1);min-width:24px}
  .slider-top{display:flex;justify-content:space-between;align-items:center}
  input[type=range]{width:100%;accent-color:var(--green);cursor:pointer;height:6px}
  .slider-ends{display:flex;justify-content:space-between;font-size:.62rem;color:#94a3b8;margin-top:2px}

  /* RESOURCE BARS */
  .res-bar-wrap{margin-bottom:8px}
  .res-bar-label{display:flex;justify-content:space-between;font-size:.78rem;font-weight:700;margin-bottom:3px}
  .res-bar-bg{background:#e2e8f0;border-radius:10px;height:14px;overflow:hidden;position:relative}
  .res-bar-fill{height:100%;border-radius:10px;transition:width .8s cubic-bezier(.4,0,.2,1),background .5s;position:relative}
  .res-bar-fill::after{content:'';position:absolute;inset:0;background:linear-gradient(90deg,transparent 60%,rgba(255,255,255,.3));border-radius:10px}
  .warn-blink{animation:warnblink .6s infinite}
  @keyframes warnblink{0%,100%{opacity:1}50%{opacity:.3}}

  /* PREDICTION WIDGET */
  .pred-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:12px}
  .pred-btn{border:3px solid transparent;background:#f8fafc;border-radius:12px;padding:10px 8px;cursor:pointer;text-align:center;font-weight:700;font-size:.85rem;transition:all .2s}
  .pred-btn:hover{transform:scale(1.04)}
  .pred-btn.sel{border-color:var(--green);background:#dcfce7;color:var(--text)}
  .pred-btn.sel-amber{border-color:var(--amber);background:#fef3c7}
  .pred-btn.sel-red{border-color:var(--red);background:#fee2e2}
  .advance-btn{width:100%;padding:14px;background:linear-gradient(135deg,#22c55e,#16a34a);color:#fff;border:none;border-radius:14px;font-family:'Fredoka One',cursive;font-size:1.2rem;cursor:pointer;box-shadow:0 4px 15px #16a34a44;transition:all .2s}
  .advance-btn:disabled{background:#d1d5db;box-shadow:none;cursor:not-allowed;color:#9ca3af}
  .advance-btn:not(:disabled):hover{transform:translateY(-2px);box-shadow:0 8px 25px #16a34a55}

  /* THREE FUTURES CARD */
  #futuresCard{display:none;background:linear-gradient(135deg,#f0fdf4,#f0f9ff);border:2px solid #86efac;border-radius:16px;padding:16px;margin-top:10px}
  .future-item{background:#fff;border-radius:10px;padding:10px 12px;margin-bottom:8px;border-left:4px solid #86efac;font-size:.82rem}
  .future-item h4{font-family:'Fredoka One',cursive;font-size:1rem;margin-bottom:4px}
  .future-A{border-left-color:#22c55e}
  .future-B{border-left-color:#f59e0b}
  .future-C{border-left-color:#ef4444}
  .rank-row{display:flex;gap:8px;margin-top:10px;flex-wrap:wrap}
  .rank-btn{flex:1;padding:8px;border:2px solid #e2e8f0;border-radius:8px;cursor:pointer;font-weight:700;font-size:.8rem;text-align:center;transition:all .2s;min-width:80px}
  .rank-btn.picked{background:#dcfce7;border-color:#16a34a}
  .justif-input{width:100%;margin-top:8px;padding:8px;border:2px solid #e2e8f0;border-radius:8px;font-family:'Nunito',sans-serif;font-size:.82rem;resize:none}
  .reveal-btn{width:100%;margin-top:10px;padding:12px;background:linear-gradient(135deg,#6366f1,#4f46e5);color:#fff;border:none;border-radius:12px;font-family:'Fredoka One',cursive;font-size:1.1rem;cursor:pointer;transition:all .2s}
  .reveal-btn:hover{transform:translateY(-2px)}

  /* ADVISOR CHIPS */
  .advisor-row{display:flex;gap:8px;flex-wrap:wrap;margin-top:4px}
  .advisor-chip{position:relative;display:flex;align-items:center;gap:6px;background:#fff;border:2px solid var(--border);border-radius:20px;padding:6px 12px;font-size:.78rem;font-weight:700;cursor:pointer;transition:all .2s;user-select:none}
  .advisor-chip:hover{background:#dcfce7;border-color:#16a34a;transform:translateY(-2px)}
  .advisor-chip .chip-tip{display:none;position:absolute;bottom:110%;left:50%;transform:translateX(-50%);background:#1a3c2b;color:#fff;padding:8px 12px;border-radius:10px;font-size:.72rem;font-weight:600;width:200px;text-align:center;z-index:100;pointer-events:none;line-height:1.4}
  .advisor-chip:hover .chip-tip{display:block}

  /* CHART */
  #chartCanvas{width:100%;height:180px;display:block;border-radius:10px}

  /* MODAL */
  #modal{display:none;position:fixed;inset:0;background:#0006;z-index:8888;align-items:center;justify-content:center}
  #modal.show{display:flex}
  .modal-box{background:#fff;border-radius:24px;padding:28px;max-width:680px;width:95%;max-height:92vh;overflow-y:auto;box-shadow:0 20px 60px #0004;border:3px solid #bbf7d0}
  .modal-title{font-family:'Fredoka One',cursive;font-size:1.8rem;margin-bottom:16px;color:var(--text)}
  .outcome-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:16px}
  .outcome-item{background:#f8fafc;border-radius:10px;padding:10px;text-align:center;border:2px solid #e2e8f0}
  .outcome-item .o-label{font-size:.72rem;font-weight:700;color:var(--sub);margin-bottom:4px}
  .outcome-item .o-val{font-family:'Fredoka One',cursive;font-size:1.1rem}
  .o-up{color:#16a34a} .o-down{color:#dc2626} .o-same{color:#d97706}
  .chain-box{background:#f0fdf4;border:2px solid #bbf7d0;border-radius:12px;padding:14px;margin-bottom:14px}
  .chain-box h4{font-family:'Fredoka One',cursive;font-size:1rem;color:#166534;margin-bottom:8px}
  .chain-step{display:flex;align-items:center;gap:8px;margin-bottom:6px;font-size:.82rem}
  .chain-arrow{color:#16a34a;font-size:1.1rem;font-weight:900}
  .rw-echo{background:linear-gradient(135deg,#fef3c7,#fde68a);border:2px solid #f59e0b;border-radius:12px;padding:14px;margin-bottom:14px}
  .rw-echo h4{font-family:'Fredoka One',cursive;font-size:1rem;color:#92400e;margin-bottom:6px}
  .ib-prompt{background:linear-gradient(135deg,#ede9fe,#ddd6fe);border:2px solid #8b5cf6;border-radius:12px;padding:14px;font-size:.85rem;color:#4c1d95}
  .ib-prompt h4{font-family:'Fredoka One',cursive;font-size:1rem;margin-bottom:6px}
  .modal-close{width:100%;margin-top:16px;padding:14px;background:linear-gradient(135deg,#22c55e,#16a34a);color:#fff;border:none;border-radius:14px;font-family:'Fredoka One',cursive;font-size:1.2rem;cursor:pointer}

  /* EVENT CARD */
  #eventCard{display:none;position:fixed;top:20px;right:20px;background:#fff;border:3px solid #f59e0b;border-radius:20px;padding:20px 24px;z-index:7777;max-width:340px;box-shadow:0 8px 30px #0003;animation:slideIn .4s ease}
  @keyframes slideIn{from{transform:translateX(120%)}to{transform:translateX(0)}}
  .event-title{font-family:'Fredoka One',cursive;font-size:1.2rem;color:#92400e;margin-bottom:8px}
  .event-body{font-size:.82rem;margin-bottom:12px}
  .event-close{background:#f59e0b;color:#fff;border:none;padding:8px 20px;border-radius:10px;cursor:pointer;font-family:'Fredoka One',cursive}

  /* TOAST */
  #toastZone{position:fixed;bottom:24px;left:50%;transform:translateX(-50%);z-index:9000;display:flex;flex-direction:column;gap:8px;align-items:center}
  .toast{background:#1a3c2b;color:#fff;padding:10px 24px;border-radius:20px;font-size:.85rem;font-weight:700;box-shadow:0 4px 20px #0004;animation:toastIn .3s ease;white-space:nowrap}
  @keyframes toastIn{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:translateY(0)}}

  /* REFLECTION */
  #reflectionPanel{display:none;background:var(--card);border-radius:16px;border:2px solid #8b5cf6;padding:20px}
  #reflectionPanel h2{font-family:'Fredoka One',cursive;font-size:1.8rem;color:#4c1d95;margin-bottom:16px}
  .ref-q{background:#ede9fe;border-radius:12px;padding:12px 14px;margin-bottom:10px;font-size:.85rem;border-left:4px solid #8b5cf6}
  .ref-q strong{font-family:'Fredoka One',cursive;color:#6d28d9;display:block;margin-bottom:4px}
  .reset-btn{background:linear-gradient(135deg,#ef4444,#dc2626);color:#fff;border:none;padding:10px 24px;border-radius:12px;font-family:'Fredoka One',cursive;font-size:1rem;cursor:pointer;margin-top:10px;transition:all .2s}
  .reset-btn:hover{transform:scale(1.05)}

  /* HEADER BAR */
  .header-bar{display:flex;justify-content:space-between;align-items:center;padding:0 4px}
  .game-title{font-family:'Fredoka One',cursive;font-size:1.5rem;color:#166534}
  .header-right{display:flex;gap:8px;align-items:center}
  .round-badge{background:#16a34a;color:#fff;padding:4px 14px;border-radius:20px;font-weight:700;font-size:.85rem}

  @media(max-width:900px){
    .main-grid{grid-template-columns:1fr}
    .sliders-grid{grid-template-columns:1fr}
    .splash-title{font-size:2rem}
  }
</style>
</head>
<body>

<!-- SPLASH -->
<div id="splash">
  <div class="splash-sun">🌞</div>
  <div class="splash-title">⚡ Energy Flow &<br>Trophic Levels</div>
  <div class="splash-sub">IB DP Biology · Ecosystem Simulation · Year 11</div>
  <div class="splash-tag">🔑 Key Concept: Interaction · ATL: Thinking & Research</div>
  <button class="splash-btn" onclick="startSim()">🌱 Start Simulation</button>
</div>

<!-- MAIN APP -->
<div id="app">
  <div class="header-bar">
    <div class="game-title">⚡ Ecosystem Energy Flow</div>
    <div class="header-right">
      <span class="round-badge" id="roundBadge">Round 1 / 5</span>
      <button class="reset-btn" onclick="resetSim()">🔄 Reset</button>
    </div>
  </div>

  <!-- PHASE TIMELINE -->
  <div class="timeline" id="timeline"></div>

  <!-- ADVISOR ROW -->
  <div class="advisor-row">
    <div class="advisor-chip">🌿 Ecologist <div class="chip-tip">Energy flow follows the 10% rule — only ~10% of energy passes to each higher trophic level.</div></div>
    <div class="advisor-chip">🌾 Farmer <div class="chip-tip">More trophic levels = more energy lost. Eating lower in the food web is more efficient for humans.</div></div>
    <div class="advisor-chip">🌍 Climate Sci. <div class="chip-tip">Higher primary productivity = more carbon sequestered. Tropical forests store vast amounts of carbon.</div></div>
    <div class="advisor-chip">🔬 Biochemist <div class="chip-tip">Transfer efficiency varies: 5–20% depending on species, metabolic rates, and habitat type.</div></div>
    <div class="advisor-chip">📊 Economist <div class="chip-tip">Land use per person rises sharply with meat-heavy diets — beef uses ~20x more land than plant protein.</div></div>
  </div>

  <div class="main-grid">
    <div class="left-col">
      <!-- SVG SCENE -->
      <div class="card" style="padding:0">
        <div id="scene-wrap">
          <svg id="mainSVG" viewBox="0 0 760 320" xmlns="http://www.w3.org/2000/svg"></svg>
        </div>
      </div>

      <!-- CHART -->
      <div class="card">
        <div class="card-title">📈 Resource Tracker (All Rounds)</div>
        <canvas id="chartCanvas" height="180"></canvas>
      </div>

      <!-- REFLECTION (shows after round 5) -->
      <div id="reflectionPanel">
        <h2>🎓 IB Reflection</h2>
        <div class="ref-q"><strong>1. Interaction</strong> What does "interaction" mean in this simulation? Give a real-world example.</div>
        <div class="ref-q"><strong>2. Unexpected Consequences</strong> Which single decision had the most unexpected consequence — and why?</div>
        <div class="ref-q"><strong>3. Cultural Perspectives</strong> How would someone from a different cultural or economic background approach these decisions differently?</div>
        <div class="ref-q"><strong>4. Evidence-Based Revision</strong> What would you change if you ran the simulation again? Use specific evidence from your results.</div>
        <div class="ref-q"><strong>5. Global Connection</strong> How does this connect to a current global issue you know about outside school?</div>
        <div class="ref-q"><strong>6. Learner Profile</strong> Did your decision-making best reflect <em>Caring</em> or <em>Thinkers</em>? Justify with evidence from your choices.</div>
      </div>
    </div>

    <div class="right-col">
      <!-- RESOURCE BARS -->
      <div class="card">
        <div class="card-title">📊 Resource Dashboard</div>
        <div id="resBars"></div>
      </div>

      <!-- SLIDERS -->
      <div class="card">
        <div class="card-title">🎛️ Set Your Variables</div>
        <div class="sliders-grid" id="slidersGrid"></div>
      </div>

      <!-- PREDICTION -->
      <div class="card">
        <div class="card-title">🔮 Make Your Prediction</div>
        <p style="font-size:.78rem;color:var(--sub);margin-bottom:10px">What outcome do you predict for this round? <strong>You must choose before advancing.</strong></p>
        <div class="pred-grid" id="predGrid"></div>

        <!-- THREE FUTURES -->
        <div id="futuresCard">
          <div style="font-family:'Fredoka One',cursive;font-size:1rem;margin-bottom:10px;color:#166534">🌳 Three Possible Futures</div>
          <div class="future-item future-A"><h4>🌟 Future A — Optimistic</h4><p id="futA"></p></div>
          <div class="future-item future-B"><h4>⚖️ Future B — Realistic</h4><p id="futB"></p></div>
          <div class="future-item future-C"><h4>💀 Future C — Pessimistic</h4><p id="futC"></p></div>
          <div style="font-size:.78rem;font-weight:700;margin-top:10px;color:var(--sub)">Rank by likelihood (pick #1):</div>
          <div class="rank-row">
            <button class="rank-btn" onclick="setRank('A')">🌟 A</button>
            <button class="rank-btn" onclick="setRank('B')">⚖️ B</button>
            <button class="rank-btn" onclick="setRank('C')">💀 C</button>
          </div>
          <textarea class="justif-input" id="justifInput" rows="2" placeholder="In one sentence, justify your #1 ranking…"></textarea>
          <button class="reveal-btn" id="revealBtn" onclick="revealResult()" disabled>🔍 Reveal Outcome</button>
        </div>

        <button class="advance-btn" id="advanceBtn" onclick="onAdvance()" disabled>🌿 Advance to Outcome</button>
      </div>
    </div>
  </div>
</div>

<!-- RESULTS MODAL -->
<div id="modal">
  <div class="modal-box">
    <div class="modal-title" id="modalTitle"></div>
    <div class="outcome-grid" id="outcomeGrid"></div>
    <div class="chain-box"><h4>⛓️ Cause → Effect Chain</h4><div id="chainBox"></div></div>
    <div id="futureReveal" style="background:#f0fdf4;border:2px solid #16a34a;border-radius:12px;padding:14px;margin-bottom:14px;display:none">
      <div style="font-family:'Fredoka One',cursive;font-size:1rem;margin-bottom:6px;color:#166534" id="futureMatchText"></div>
      <div style="font-size:.82rem;color:var(--sub)" id="futureWhyNot"></div>
      <div style="margin-top:10px;font-size:.82rem;font-weight:700;color:#166534" id="futureDiscuss"></div>
    </div>
    <div class="rw-echo"><h4>🌍 Real-World Echo</h4><p id="rwEcho" style="font-size:.82rem"></p></div>
    <div class="ib-prompt"><h4>💡 IB Thinking Prompt</h4><p id="ibPrompt" style="font-size:.82rem"></p></div>
    <button class="modal-close" onclick="closeModal()">✅ Continue to Next Round</button>
  </div>
</div>

<!-- EVENT CARD -->
<div id="eventCard">
  <div class="event-title" id="evTitle">⚡ Random Event!</div>
  <div class="event-body" id="evBody"></div>
  <button class="event-close" onclick="dismissEvent()">Got it!</button>
</div>

<!-- TOAST ZONE -->
<div id="toastZone"></div>

<script>
// ============================================================
// STATE
// ============================================================
const ROUNDS = 5;
let state = {
  round: 1,
  prediction: null,
  futureRank: null,
  phase: 'sliders', // sliders → futures → reveal → modal
  sliders: { prod:2, eff:2, levels:2, human:2 },
  metrics: { energy0:80, energy1:50, energy2:20, land:40, carbon:65 },
  history: [],
  eventsUsed: [],
  done: false
};

const SLIDER_CFG = [
  { key:'prod',  label:'Primary Productivity', lo:'Low (Desert)', hi:'High (Tropical Forest)', icon:'🌿' },
  { key:'eff',   label:'Energy Transfer Efficiency', lo:'5% (Low)', hi:'20% (High)', icon:'⚡' },
  { key:'levels',label:'Trophic Levels', lo:'2 Levels', hi:'5 Levels', icon:'🔺' },
  { key:'human', label:'Human Consumption', lo:'Plant-based', hi:'All Meat', icon:'🍽️' }
];

const PREDICTIONS = [
  { id:'thriving', emoji:'🌱', label:'Thriving', cls:'sel' },
  { id:'stable',   emoji:'⚖️', label:'Stable',   cls:'sel' },
  { id:'stressed', emoji:'⚠️', label:'Resources Stressed', cls:'sel-amber' },
  { id:'crisis',   emoji:'🔴', label:'Crisis',   cls:'sel-red' }
];

const EVENTS = [
  { id:'drought', title:'🔥 Drought Event!', body:'A sudden drought reduces primary productivity by 20% this round — ecosystems with low diversity suffer most.' },
  { id:'invasive', title:'🦟 Invasive Species!', body:'An invasive herbivore arrives, consuming 15% of producer biomass. Systems with high trophic levels buffer the impact better.' },
  { id:'eutro', title:'💧 Eutrophication!', body:'Excess nutrient runoff from high-meat-diet agriculture has caused an algal bloom — carbon sequestration drops by 15%.' }
];

const RW_ECHOES = [
  '🐄 Beef production requires ~20x more land and 10x more water than equivalent plant protein. Brazil\'s Amazon deforestation is 70–80% driven by cattle ranching.',
  '🌊 Open-ocean food webs can have 5–6 trophic levels — yet commercial fish harvests collapse when top predators are over-targeted (e.g. Pacific bluefin tuna).',
  '🌾 Biofuels convert only 0.1–3% of solar energy into usable fuel — far less efficient than photovoltaics, echoing the 10% rule of ecological energy transfer.',
  '🌳 The Amazon produces ~10% of global oxygen and sequesters billions of tonnes of CO₂. Its primary productivity is the highest of any terrestrial ecosystem.',
